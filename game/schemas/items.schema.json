{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "items.schema.json",
  "title": "Items",
  "description": "Inventory items, gear and consumables.",
  "x-collection": "items",
  "type": "object",
  "required": [
    "collection",
    "items"
  ],
  "properties": {
    "collection": {
      "const": "items"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "tags": {
            "$ref": "common.schema.json#/$defs/tags"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "category": {
            "enum": [
              "food",
              "drink",
              "gear",
              "clothing",
              "phone_app",
              "document",
              "gift",
              "tool",
              "collectible"
            ]
          },
          "price_vnd": {
            "$ref": "common.schema.json#/$defs/money_vnd"
          },
          "effects": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "description": {
            "$ref": "common.schema.json#/$defs/text"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
